# ==============================================================================
# MockMate - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
APP_NAME="MockMate API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"          # Options: development, testing, production
RATE_LIMIT_ENABLED=true            # Enable API rate limiting (slowapi)

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Local development default (PostgreSQL listening on localhost:5432):
# DATABASE_URL="postgresql+psycopg://postgres:your_password@localhost:5432/mockmate"
#
# Docker Compose default (container mapping on port 5433):
# DATABASE_URL="postgresql+psycopg://mockmate:mockmate_dev_secret@localhost:5433/mockmate_db"
#
# Render Managed PostgreSQL (auto-injected or provided by Render dashboard):
DATABASE_URL="postgresql+psycopg://mockmate:your_secure_password@your-db-host.render.com/mockmate_db"

# ------------------------------------------------------------------------------
# Groq LLM API Configuration
# ------------------------------------------------------------------------------
# Obtain your free API key at https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="openai/gpt-oss-120b"

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY="your_secure_random_jwt_secret_key_minimum_32_characters"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated)
# ------------------------------------------------------------------------------
# Specify all allowed web frontend origins accessing the FastAPI backend:
CORS_ORIGINS="http://localhost:8501,http://127.0.0.1:8501,https://mockmate-frontend.onrender.com"

# ------------------------------------------------------------------------------
# Frontend (Streamlit) Configuration
# ------------------------------------------------------------------------------
# URL pointing to the FastAPI backend API:
# Local development: http://127.0.0.1:8000
# Docker internal network: http://backend:8000
# Render production: https://mockmate-backend.onrender.com
MOCKMATE_API_URL="http://127.0.0.1:8000"
